# =============================================================================
# JETWISE AI — Multi-Provider Aerospace Simulation & Intelligence Platform
# =============================================================================
# SECURITY DIRECTIVE:
# Never commit actual API keys or credentials to version control.
# Copy this file to .env and insert newly generated replacement tokens.
#
# All providers are optional; JETWISE AI functions 100% locally with internal
# PyTorch deep learning models, Brayton cycle aerothermal physics engine,
# and deterministic aerospace rule-based NLU if external APIs are unconfigured.
# =============================================================================

# 1. Google Gemini API (Recommended for conversational aerospace engineering copilot)
# Get replacement key from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# 2. Hugging Face Access Token (For Model Hub, gated models, inference discovery)
# Get least-privilege replacement token from: https://huggingface.co/settings/tokens
HF_TOKEN=

# 3. OpenAI API (Optional alternative provider)
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 4. MATLAB Local Installation Path (Optional override if not detected automatically)
# Example Windows path: C:\Program Files\MATLAB\R2024a\bin\matlab.exe
MATLAB_EXECUTABLE_PATH=
